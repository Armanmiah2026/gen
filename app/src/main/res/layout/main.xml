<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">
<ScrollView
    android:layout_width="fill_parent"
    android:fillViewport="true"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="fill_parent"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="5dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="10dp"
                    app:cardElevation="5dp"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="fill_parent"
                            android:text="Hi Admin, username"
                            android:textStyle="bold"
                            android:layout_height="wrap_content"
                            android:id="@+id/user_info"/>
                        <TextView
                            android:layout_width="fill_parent"
                            android:text="App Name: null"
                            android:textStyle="bold"
                            android:id="@+id/app_info"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:layout_width="fill_parent"
                            android:text="Server Count: 0"
                            android:textStyle="bold"
                            android:layout_height="wrap_content"
                            android:id="@+id/server_info"/>

                        <TextView
                            android:layout_width="fill_parent"
                            android:text="Payload Count: 0"
                            android:textStyle="bold"
                            android:layout_height="wrap_content"
                            android:id="@+id/payload_info"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:id="@+id/logout"
                            android:layout_gravity="center|right"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="fill_parent"
                                android:text="Logout"
                                android:textStyle="bold"
                                android:layout_marginRight="5dp"
                                android:textColor="@color/main_color"
                                android:layout_height="wrap_content" />
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_shutdown"
                                app:tint="@color/main_color"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="fill_parent"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="5dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="10dp"
                    app:cardElevation="5dp"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="45dp"
                            android:id="@+id/configuration_layout"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_configuration"
                                app:tint="#ff000000"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:text="Set Configuration Settings"
                                android:textStyle="bold"
                                android:layout_marginRight="5dp"
                                android:layout_marginLeft="10dp"
                                android:textColor="#ff000000"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_right"
                                app:tint="#ff000000"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="45dp"
                            android:id="@+id/prefs_lay"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_setting"
                                app:tint="#ff000000"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:text="Set Preference Settings"
                                android:textStyle="bold"
                                android:layout_marginRight="5dp"
                                android:layout_marginLeft="10dp"
                                android:textColor="#ff000000"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_right"
                                app:tint="#ff000000"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp">

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save"
                        android:id="@+id/btnSave" />

                </LinearLayout>





                <!--  <TextView
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content"
                      android:id="@+id/result"/>
                      -->
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="bottom|right">
                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:id="@+id/announcement"
                    android:layout_gravity="bottom|right"
                    app:cardBackgroundColor="@color/main_color"
                    app:cardCornerRadius="25dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginBottom="10dp"
                    app:cardElevation="5dp"
                    android:layout_height="50dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_announcement"
                        android:layout_gravity="center"
                        app:tint="#ffffffff"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="50dp"
                    android:id="@+id/contact_us"
                    android:layout_gravity="bottom|right"
                    app:cardBackgroundColor="@color/main_color"
                    app:cardCornerRadius="25dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginBottom="15dp"
                    app:cardElevation="5dp"
                    android:layout_height="50dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_support"
                        android:layout_gravity="center"
                        app:tint="#ffffffff"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>
</ScrollView>
</LinearLayout>