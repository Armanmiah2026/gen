<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:padding="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select protocol" />
        <Spinner
            android:id="@+id/proto_spin"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginStart="0.0dip"
            android:layout_marginEnd="0.0dip" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Server" />
        <RadioGroup
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/cf_radio"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Mode 1"
                android:layout_weight="1.0" />
            <RadioButton
                android:id="@+id/ws_radio"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Mode 2"
                android:layout_weight="1.0" />
            <RadioButton
                android:id="@+id/http_radio"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Mode 3"
                android:layout_weight="1.0" />
        </RadioGroup>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/modeGroup"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/mode1"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Mode 1"
                android:layout_weight="1.0" />
            <RadioButton
                android:id="@+id/mode2"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Mode 2"
                android:layout_weight="1.0" />
            <RadioButton
                android:id="@+id/mode3"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Mode 3"
                android:layout_weight="1.0" />
        </RadioGroup>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/network_name_dialog"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="Network Name"
                android:ems="10" />
        </com.google.android.material.textfield.TextInputLayout>
        <CheckBox
            android:id="@+id/is_custom_config"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.0dip"
            android:text="Custom Config" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/etNetworkPayloadInput"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.0dip">
            <EditText
                android:id="@+id/network_payload_dialog"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="Payload"
                android:maxLines="5"
                android:ems="10" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0.0dip">
            <EditText
                android:id="@+id/network_info_dialog"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="Network Info"
                android:ems="10" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/excluded_udp_layout"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10.0dip"
                    android:text="Proxy Settings" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="2.5dip"
                        android:layout_weight="1.0">
                        <EditText
                            android:id="@+id/proxy_edit"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:hint="Squid Proxy/IP"
                            android:ems="10"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2.5dip"
                        android:layout_weight="2.0">
                        <EditText
                            android:id="@+id/proxy_port_edit"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:hint="Squid Port"
                            android:singleLine="true"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="right"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <CheckBox
                        android:id="@+id/use_default_proxy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use Default Proxy" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.0dip"
                android:layout_marginBottom="5.0dip">
                <EditText
                    android:id="@+id/network_front_query"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:hint="FrontQuery (optional)"
                    android:ems="10" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5.0dip">
                <EditText
                    android:id="@+id/network_back_query"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:hint="BackQuery (optional)"
                    android:ems="10" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <Spinner
            android:id="@+id/priority_spin"
            android:layout_width="fill_parent"
            android:layout_height="50.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginBottom="0.0dip"
            android:layout_marginStart="0.0dip"
            android:layout_marginEnd="0.0dip" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip">
            <Button
                android:id="@+id/btnPayloadGen"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="3.0dip"
                android:text="Generator"
                android:layout_weight="1.0" />
            <Button
                android:id="@+id/btnSaveNetwork"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3.0dip"
                android:text="Save Network"
                android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>