<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_vertical" android:id="@+id/base_server_grab" android:orientation="horizontal" android:layout_width="fill_parent" android:minHeight="45dp" android:layout_height="60dp">
   <androidx.cardview.widget.CardView
       android:layout_width="fill_parent"
       app:cardBackgroundColor="#FFFFFF"
       app:cardCornerRadius="5dp"
       android:layout_marginLeft="10dp"
       android:layout_marginRight="10dp"
       app:cardElevation="5dp"
       android:layout_height="50dp">
       <LinearLayout
           android:layout_width="fill_parent"
           android:layout_height="fill_parent"
           android:gravity="center"
           android:orientation="horizontal">
           <ImageView
               android:visibility="visible"
               android:id="@+id/server_item_icon"
               android:layout_width="25.0dip"
               android:layout_height="25.0dip"
               android:layout_marginLeft="10.0dip"
               android:src="@mipmap/ic_launcher" />
           <LinearLayout
               android:padding="0dp"
               android:gravity="center_vertical"
               android:orientation="vertical"
               android:layout_width="fill_parent"
               android:layout_height="wrap_content"
               android:layout_marginLeft="10.0dip"
               android:layout_marginRight="0.0dip"
               android:layout_weight="1.0">
               <TextView
                   android:textSize="10.0sp"
                   android:textStyle="bold"
                   android:textColor="#ff000000"
                   android:id="@+id/server_item_text"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:singleLine="true" />
               <TextView
                   android:textSize="9.0sp"
                   android:typeface="serif"
                   android:textColor="@color/main_color"
                   android:text="@string/app_name"
                   android:visibility="visible"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_marginBottom="0.0dip" />
           </LinearLayout>
           <ImageView
               android:visibility="visible"
               android:id="@+id/server_edit"
               android:layout_width="25.0dip"
               android:layout_height="25.0dip"
               android:layout_marginRight="5.0dip"
               android:layout_marginLeft="0.0dip"
               android:src="@drawable/ic_edit_item" />
           <ImageView
               android:visibility="visible"
               android:id="@+id/server_delete"
               android:layout_width="25.0dip"
               android:layout_height="25.0dip"
               android:padding="1dp"
               android:layout_marginRight="5.0dip"
               android:layout_marginLeft="10.0dip"
               android:src="@drawable/ic_delete_item" />
           <ImageView
               android:visibility="visible"
               android:id="@+id/server_drag"
               android:layout_width="25.0dip"
               android:layout_height="25.0dip"
               android:layout_marginRight="10.0dip"
               android:layout_marginLeft="10.0dip"
               android:src="@drawable/ic_drag" />
           <TextView
               android:textSize="10.0sp"
               android:text="Random"
               android:visibility="gone"
               android:textStyle="bold"
               android:textColor="#AB3BE3"
               android:gravity="center_vertical"
               android:id="@+id/server_item_indicator"
               android:padding="0.0dip"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginLeft="0.0dip"
               android:layout_marginRight="10.0dip"
               android:singleLine="true"  />
       </LinearLayout>
   </androidx.cardview.widget.CardView>

</LinearLayout>
